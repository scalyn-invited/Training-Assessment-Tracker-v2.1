{
  "name": "training-assessment-tracker-v2-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.server.json && npm run build --workspace=@tracker/web",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && npm run typecheck --workspace=@tracker/web",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres.test.ts tests/demo-postgres.test.ts tests/foundation-checks-postgres.test.ts tests/operator-bootstrap-postgres.test.ts tests/client-services-postgres.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "start:web": "npm run start --workspace=@tracker/web",
    "verify:baseline": "tsx scripts/verify-baseline.ts",
    "test:postgres:local": "tsx scripts/postgres-local.ts",
    "test:documents:local": "tsx scripts/document-tools-local.ts",
    "integration:local": "tsx scripts/integration-local.ts",
    "operations": "tsx scripts/operations.ts",
    "setup:prepare": "tsx scripts/setup-prepare.ts",
    "setup:serve": "tsx apps/api/src/setup.ts",
    "start:setup": "node dist/apps/api/src/setup.js",
    "setup:upgrade:local": "tsx scripts/setup-upgrade-local.ts",
    "setup:token": "tsx scripts/setup-token.ts",
    "demo:seed": "tsx scripts/realistic-demo.ts seed",
    "demo:global-admin": "tsx scripts/realistic-demo.ts global-admin",
    "training:global-admin": "tsx scripts/operator-bootstrap.ts global-admin",
    "training:local-setup": "tsx scripts/operator-bootstrap.ts local-setup",
    "training:initialize-production": "tsx scripts/operator-bootstrap.ts initialize-production",
    "training:initialize-local-production": "tsx scripts/operator-bootstrap.ts initialize-local-production",
    "start:local-production": "tsx scripts/local-production.ts",
    "test:web-headers": "tsx scripts/verify-web-headers.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@tiptap/core": "3.33.1",
    "@tiptap/extension-image": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "htmlparser2": "12.0.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.2",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/sax": "1.2.7",
    "@types/yauzl": "3.4.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
