{
  "name": "training-assessment-tracker-v2-1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsc -p tsconfig.server.json && npm run build --workspace=@tracker/web",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && npm run typecheck --workspace=@tracker/web",
    "test": "vitest run",
    "test:postgres": "vitest run tests/postgres.test.ts",
    "test:browser": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "start:web": "npm run start --workspace=@tracker/web",
    "verify:baseline": "tsx scripts/verify-baseline.ts",
    "test:postgres:local": "tsx scripts/postgres-local.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "next": "16.4.6",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
