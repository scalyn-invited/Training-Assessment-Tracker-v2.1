ared shell and overview, inspired by the approved reference. */\nbody{font-family:Inter,\"Segoe UI\",sans-serif}\n.app-sidebar{width:240px}.app-layout .app-content{margin-left:240px}\n.sidebar-top{padding:38px 28px 30px}.brand-copy strong{font-size:24px;letter-spacing:-1px}.brand-copy>span{font-size:10px;max-width:135px}.brand-symbol{max-width:50px}\n.workspace-nav-label{font-size:9px;text-transform:uppercase;letter-spacing:1.7px;margin:30px 28px 26px}\n.sidebar-nav{padding:0 28px;gap:10px}.sidebar-nav>a{min-height:50px;padding:12px 16px;font-size:14px;gap:13px}.sidebar-nav .icon{width:15px;height:15px}\n.sidebar-nav>a[aria-current]{background:var(--primary);color:var(--on-primary);font-weight:600}\n.sidebar-bottom{border:0;padding:14px 28px 22px}.sidebar-message{font-size:16px;line-height:1.5;color:var(--ink);margin:8px 0 20px}.sidebar-message>span{display:block;font-size:9px;text-transform:uppercase;letter-spacing:1.5px;color:var(--muted);margin-bottom:8px}\n.workspace-header{height:88px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:20px;padding:0 46px;background:var(--bg);color:var(--muted);font-size:11px}.workspace-header .profile{padding:0;gap:12px}.workspace-header .profile-copy{flex:initial}.workspace-header .profile-copy strong{font-weight:400;max-width:250px}.workspace-header .profile-copy small{display:none}.workspace-header .avatar{background:var(--soft);border:0;font-size:11px}\n.container{max-width:1260px;padding:54px 64px 60px;min-height:calc(100vh - 172px)}\nh1{font-size:31px;letter-spacing:-1px;font-weight:600}.eyebrow{font-size:9px;letter-spacing:1.8px;margin-bottom:23px}.lead{font-size:13px;margin-top:14px}.workspace-welcome{align-items:center;margin-bottom:30px}.welcome-period{color:var(--muted)}\n.signed-in{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:24px;padding:9px 14px;font-size:9px;letter-spacing:1px;text-transform:uppercase;white-space:nowra