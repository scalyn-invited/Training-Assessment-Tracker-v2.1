y\", \"Insert or edit link\"));\n      const link = field(linkFields, \"Link URL\", \"\", () => {\n      }, \"prompt-link\", \"url\");\n      linkFields.append(button(\"Apply link\", () => {\n        try {\n          const url = new URL(link.value);\n          if (![\"https:\", \"http:\", \"mailto:\"].includes(url.protocol)) throw Error();\n          editor.chain().focus().extendMarkRange(\"link\").setLink({ href: url.href }).run();\n          linkFields.open = false;\n        } catch {\n          link.setCustomValidity(\"Use an https, http or mailto link.\");\n          link.reportValidity();\n        }\n      }), button(\"Remove link\", () => editor.chain().focus().unsetLink().run()));\n      link.addEventListener(\"input\", () => link.setCustomValidity(\"\"));\n      card.append(linkFields);\n      const imageFields = el(\"details\", null);\n      imageFields.append(el(\"summary\", \"Insert image or edit alt text\"));\n      const alt = field(imageFields, \"Image alt text\", \"\", () => {\n      }, \"image-alt\");\n      alt.maxLength = 500;\n      const file = field(imageFields, \"Image file (PNG, JPEG or WebP, up to 2 MiB)\", \"\", () => {\n      }, \"prompt-image\", \"file\");\n      file.accept = \".png,.jpg,.jpeg,.webp\";\n      const uploadStatus = el(\"p\", \"\", { role: \"status\" });\n      const progress = el(\"progress\", null, { max: \"100\", value: \"0\", \"aria-label\": \"Image upload progress\", hidden: \"\" });\n      let mediaId, selectedFile;\n      file.addEventListener(\"change\", () => {\n        mediaId = null;\n        selectedFile = file.files[0];\n      });\n      const uploadButton = button(\"Upload and insert image\", async () => {\n        if (uploadPending) return;\n        selectedFile = file.files[0] || selectedFile;\n        if (!selectedFile && !mediaId) {\n          uploadStatus.textContent = \"Choose an image to upload.\";\n          return;\n        }\n        if (!alt.value.trim()) {\n          uploadStatus.textContent = \"Add alt text describing the image before inserting it.\";\n          alt.focus();\n          return;\n        }\n        if (selectedFile?.size > 2 * 1024 * 1024) {\n          uploadStatus.textContent = \"Choose an image smaller than 2 MiB.\";\n          return;\n        }\n        uploadPending = true;\n        uploadButton.disabled = true;\n        uploadStatus.textContent = \"Uploading image\\u2026\";\n        updatePublish();\n        const altText = alt.value;\n        try {\n          if (mediaId) {\n            const previous = await request(`/assessments/media/${mediaId}/status`);\n            if (previous.status === \"unavailable\") await request(`/assessments/media/${mediaId}/retry`, {});\n          } else {\n            const data = new FormData();\n            data.append(\"csrf\", csrf);\n            data.append(\"clientId\", root.dataset.client);\n            data.append(\"image\", selectedFile);\n            progress.hidden = false;\n            const result2 = await upload(data, (percent) => progress.value = percent);\n            mediaId = result2.id;\n          }\n          progress.hidden = true;\n          uploadStatus.textContent = \"Checking the image. Your prompt is preserved.\";\n          let result;\n          for (let i2 = 0; i2 < 75; i2++) {\n            result = await request(`/assessments/media/${mediaId}/status`);\n            if (![\"quarantined\", \"scanning\"].includes(result.status)) break;\n            await new Promise((resolve) => setTimeout(resolve, 2e3));\n          }\n          if (result.status !== \"ready\") {\n            if (result.status === \"rejected\") {\n              mediaId = null;\n              throw Error(\"This image was rejected. Choose another image.\");\n            }\n            throw Error(\"Image processing is unavailable or still pending. Retry after the scanner and worker are available.\");\n          }\n          if (selected === q.id && editor) editor.chain().focus().setTextSelection(editor.state.selection.to).setImage({ src: result.url, alt: altText }).run();\n          else {\n            q.prompt_html = (q.prompt_html ?? `<p>${escapeText(q.prompt)}</p>`) + `<p><img src=\"${result.url}\" alt=\"${escapeText(altText)}\"></p>`;\n            changed();\n          }\n          mediaId = null;\n          selectedFile = null;\n          file.value = \"\";\n          uploadStatus.textContent = \"Image inserted. Save the draft to keep it.\";\n        } catch (error) {\n          uploadStatus.textContent = error.message + \" Your prompt is intact.\";\n          uploadButton.textContent = \"Retry image upload\";\n        } finally {\n          uploadPending = false;\n          uploadButton.disabled = false;\n          progress.hidden = true;\n          updatePublish();\n        }\n      });\n      imageFields.append(uploadButton, button(\"Update selected image alt text\", () => {\n        if (!editor.isActive(\"image\")) {\n          uploadStatus.textContent = \"Select an image in the prompt first.\";\n          return;\n        }\n        editor.chain().focus().updateAttributes(\"image\", { alt: alt.value }).run();\n      }), progress, uploadStatus);\n      card.append(imageFields);\n      if (q.type === \"multiple_choice\") renderChoices(card, q);\n      if (q.type === \"self_assessment\") renderMatrix(card, q);\n      const errors = readiness();\n      const relevant = Object.entries(errors).filter(([key]) => key.startsWith(`questions.${index}.`));\n      {\n        const list = el(\"ul\", null, { class: \"builder-field-errors\" });\n        relevant.forEach(([, message]) => list.append(el(\"li\", message)));\n        list.hidden = !relevant.length;\n        card.append(list);\n      }\n    }\n    function renderMatrix(card, q) {\n      const m = q.matrix;\n      field(card, \"Matrix learner instructions (optional)\", m.instructions, (value) => m.instructions = value, \"matrix-instructions\", \"textarea\").maxLength = 4e3;\n      for (const [key, text] of [[\"required\", \"Require a rating for every area\"], [\"notes_enabled\", \"Include optional Notes column\"]]) {\n        const label = el(\"label\", null, { class: \"correct-choice\" }), checkbox = el(\"input\", null, { type: \"checkbox\" });\n        checkbox.checked = m[key];\n        checkbox.addEventListener(\"change\", () => {\n          m[key] = checkbox.checked;\n          changed();\n        });\n        label.append(checkbox, document.createTextNode(text));\n        card.append(label);\n      }\n      for (const [kind, singular, maximum] of [[\"areas\", \"Assessment area\", 30], [\"ratings\", \"Rating heading\", 10]]) {\n        const group = el(\"fieldset\", null);\n        group.append(el(\"legend\", kind === \"areas\" ? \"Assessment areas\" : \"Rating columns\"));\n        m[kind].forEach((item, i2) => {\n          const row = el(\"div\", null, { class: \"matrix-author-row\" });\n          field(row, `${singular} ${i2 + 1}`, item.text, (value) => item.text = value, `matrix-${kind}-${item.id}`, kind === \"areas\" ? \"textarea\" : \"text\").maxLength = kind === \"areas\" ? 4e3 : 120;\n          const actions = el(\"div\", null, { class: \"builder-actions\" });\n          for (const [direction, delta] of [[\"up\", -1], [\"down\", 1]]) {\n            const control = button(`Move ${kind === \"areas\" ? \"area\" : \"rating\"} ${i2 + 1} ${direction}`, () => {\n              move(m[kind], i2, delta);\n              renderQuestion();\n              $(`matrix-${kind}-${item.id}`).focus();\n            });\n            control.disabled = i2 + delta < 0 || i2 + delta >= m[kind].length;\n            actions.append(control);\n          }\n          actions.append(button(`Remove ${kind === \"areas\" ? \"area\" : \"rating\"} ${i2 + 1}`, () => {\n            matrixRemoved.push({ question: q.id, kind, item: clone(item), index: i2 });\n            m[kind].splice(i2, 1);\n            changed();\n            renderQuestion();\n            $(`add-matrix-${kind}`).focus();\n          }));\n          row.append(actions);\n          group.append(row);\n        });\n        const add = button(kind === \"areas\" ? \"Add assessment area\" : \"Add rating column\", () => {\n          const item = { id: uuid(), text: \"\" };\n          m[kind].push(item);\n          changed();\n          renderQuestion();\n          $(`matrix-${kind}-${item.id}`).focus();\n        }, { id: `add-matrix-${kind}` });\n        add.disabled = m[kind].length >= maximum;\n        group.append(add);\n        card.append(group);\n      }\n      const removedIndex = matrixRemoved.findLastIndex((item) => item.question === q.id);\n      if (removedIndex >= 0) card.append(button(\"Undo matrix removal\", () => {\n        const last = matrixRemoved[removedIndex];\n        if (m[last.kind].length >= (last.kind === \"areas\" ? 30 : 10)) {\n          status(\"Make room before restoring this item.\");\n          return;\n        }\n        m[last.kind].splice(last.index, 0, last.item);\n        matrixRemoved.splice(removedIndex, 1);\n        changed();\n        renderQuestion();\n        $(`matrix-${last.kind}-${last.item.id}`).focus();\n      }));\n    }\n    function renderChoices(card, q) {\n      const group = el(\"fieldset\", null);\n      group.append(el(\"legend\", \"Answer choices\"), el(\"p\", \"Choose one correct answer. Unanswered learner questions score zero.\"));\n      q.choices.forEach((choice, i2) => {\n        const row = el(\"div\", null, { class: \"builder-choice\" });\n        const input = field(row, `Choice ${i2 + 1}`, choice.text, (value) => choice.text = value, \"choice-\" + choice.id);\n        input.maxLength = 1e3;\n        const label = el(\"label\", null, { class: \"correct-choice\" });\n        const radio = el(\"input\", null, { type: \"radio\", name: \"correct-\" + q.id, value: choice.id, \"aria-label\": `Correct answer: choice ${i2 + 1}` });\n        radio.checked = state.answer_key[q.id] === choice.id;\n        radio.addEventListener(\"change\", () => {\n          state.answer_key[q.id] = choice.id;\n          changed();\n        });\n        label.append(radio, document.createTextNode(\"Correct answer\"));\n        row.append(label);\n        const actions = el(\"div\", null, { class: \"builder-actions\" });\n        for (const [name, delta] of [[\"up\", -1], [\"down\", 1]]) {\n          const b = button(`Move choice ${name}`, () => {\n            move(q.choices, i2, delta);\n            renderQuestion();\n            $(\"choice-\" + choice.id).focus();\n          }, { \"aria-label\": `Move choice ${i2 + 1} ${name}` });\n          b.disabled = i2 + delta < 0 || i2 + delta >= q.choices.length;\n          actions.append(b);\n        }\n        actions.append(button(\"Remove choice\", () => {\n          q.choices.splice(i2, 1);\n          if (state.answer_key[q.id] === choice.id) delete state.answer_key[q.id];\n          changed();\n          renderQuestion();\n          $(\"add-choice\").focus();\n        }, { \"aria-label\": `Remove choice ${i2 + 1}` }));\n        row.append(actions);\n        group.append(row);\n      });\n      const add = button(\"Add choice\", () => {\n        const c = { id: uuid(), text: \"\" };\n        q.choices.push(c);\n        changed();\n        renderQuestion();\n        $(\"choice-\" + c.id).focus();\n      }, { id: \"add-choice\" });\n      add.disabled = q.choices.length >= 30;\n      group.append(add);\n      card.append(group);\n    }\n    root.querySelectorAll(\"[data-add-question]\").forEach((b) => b.addEventListener(\"click\", () => {\n      const q = newQuestion();\n      state.questions.push(q);\n      activeSection()?.question_ids.push(q.id);\n      syncOrder();\n      renderSections();\n      selected = q.id;\n      changed();\n      renderList();\n      renderQuestion();\n      $(\"question-type\").focus();\n    }));\n    $(\"undo-question\").addEventListener(\"click\", () => {\n      if (state.questions.length >= 30) {\n        status(\"Remove another question before restoring this one; the limit is 30.\");\n        return;\n      }\n      const last = removed[removed.length - 1];\n      if (!last) return;\n      if (state.sections !== null && !state.sections.some((s) => s.id === last.sectionId)) {\n        status(\"Undo the section removal first, or restore the question before removing its section.\");\n        return;\n      }\n      removed.pop();\n      if (state.sections !== null) {\n        selectedSection = last.sectionId;\n        activeSection().question_ids.splice(last.localIndex, 0, last.question.id);\n      }\n      state.questions.splice(Math.min(last.index, state.questions.length), 0, last.question);\n      if (last.key) state.answer_key[last.question.id] = last.key;\n      syncOrder();\n      renderSections();\n      selected = last.question.id;\n      $(\"removed-question\").hidden = !removed.length;\n      changed();\n      renderList();\n      renderQuestion();\n      $(\"question-type\").focus();\n    });\n    function renderRubric(openId) {\n      const cards = $(\"criterion-cards\");\n      cards.replaceChildren();\n      if (!state.criteria.length) cards.append(el(\"p\", \"No criteria yet. Add a criterion for open responses. A multiple-choice-only assessment does not need a rubric.\"));\n      state.criteria.forEach((c, i2) => {\n        const details = el(\"details\", null);\n        details.open = c.id === openId;\n        details.append(el(\"summary\", `${i2 + 1}. ${c.label || \"Untitled criterion\"}`));\n        for (const [key, label, type, max] of [[\"category\", \"Category\", \"text\", 120], [\"label\", \"Criterion\", \"text\", 180], [\"guidance\", \"Scoring guidance\", \"textarea\", 4e3]]) {\n          const input = field(details, label, c[key], (value) => c[key] = value, `criterion-${c.id}-${key}`, type);\n          input.maxLength = max;\n        }\n        const weight = field(details, \"Weight (%)\", c.weight == null ? \"\" : Number((c.weight * 100).toFixed(4)), (value) => {\n          c.weight = value === \"\" ? null : Number(value) / 100;\n          weightTotal();\n        }, `criterion-${c.id}-weight`, \"number\");\n        weight.min = \"0\";\n        weight.max = \"100\";\n        weight.step = \"0.0001\";\n        details.append(button(\"Remove criterion\", () => {\n          if (!confirm(\"Remove this scoring criterion from the draft?\")) return;\n          state.criteria.splice(i2, 1);\n          changed();\n          renderRubric();\n          $(\"add-criterion\").focus();\n        }));\n        cards.append(details);\n      });\n      $(\"add-criterion\").disabled = state.criteria.length >= 30;\n      $(\"equal-weights\").disabled = !state.criteria.length;\n      weightTotal();\n    }\n    function weightTotal() {\n      $(\"weight-total\").textContent = `Total weight: ${(state.criteria.reduce((sum, c) => sum + Number(c.weight || 0), 0) * 100).toFixed(4).replace(/\\.?0+$/, \"\") || \"0\"}% \\xB7 Required: 100%`;\n    }\n    $(\"add-criterion\").addEventListener(\"click\", () => {\n      const c = { id: uuid(), category: \"\", label: \"\", guidance: \"\", weight: null };\n      state.criteria.push(c);\n      changed();\n      renderRubric(c.id);\n      $(`criterion-${c.id}-category`).focus();\n    });\n    $(\"equal-weights\").addEventListener(\"click\", () => {\n      const n = state.criteria.length, base2 = Math.floor(1e6 / n), extra = 1e6 % n;\n      state.criteria.forEach((c, i2) => c.weight = (base2 + (i2 < extra ? 1 : 0)) / 1e6);\n      changed();\n      renderRubric(state.criteria[0]?.id);\n    });\n    function readiness() {\n      const errors = {};\n      if (state.sections !== null) {\n        if (!state.sections.length) errors.sections = \"Add at least one section.\";\n        state.sections.forEach((s, i2) => {\n          if (!s.title?.trim()) errors[`sections.${i2}.title`] = `Section ${i2 + 1}: add a title.`;\n          if (!s.question_ids.length) errors[`sections.${i2}.question_ids`] = `Section ${i2 + 1}: add at least one question.`;\n        });\n      }\n      if (!state.title.trim()) errors.title = \"Add an assessment title.\";\n      if (state.threshold !== null && (!Number.isFinite(state.threshold) || state.threshold < 0 || state.threshold > 100)) errors.threshold = \"Use a threshold from 0 to 100.\";\n      if (!state.questions.length) errors.questions = \"Add at least one question.\";\n      state.questions.forEach((q, i2) => {\n        if (!q.prompt.trim()) errors[`questions.${i2}.prompt`] = `Question ${i2 + 1}: add a prompt.`;\n        if (q.type === \"self_assessment\") Object.assign(errors, matrixReadiness(q, i2));\n        if (q.type === \"multiple_choice\") {\n          if (q.choices.length < 2 || q.choices.some((c) => !c.text?.trim())) errors[`questions.${i2}.choices`] = `Question ${i2 + 1}: add at least two choices and complete every choice.`;\n          if (!q.choices.some((c) => c.id === state.answer_key[q.id])) errors[`questions.${i2}.correct`] = `Question ${i2 + 1}: select one correct answer.`;\n        }\n      });\n      if (state.questions.some((q) => q.type === \"open_response\") && !state.criteria.length) errors.criteria = \"Add a rubric for open responses.\";\n      state.criteria.forEach((c, i2) => {\n        for (const field2 of [\"category\", \"label\", \"guidance\", \"weight\"]) if (!c[field2] || typeof c[field2] === \"string\" && !c[field2].trim()) errors[`criteria.${i2}.${field2}`] = `Criterion ${i2 + 1}: complete ${field2}.`;\n      });\n      if (state.criteria.length && Math.abs(state.criteria.reduce((n, c) => n + Number(c.weight || 0), 0) - 1) >= 1e-6) errors.criteria = \"Criterion weights must total 100%.\";\n      return { ...errors, ...serverErrors };\n    }\n    function updateCardErrors() {\n      const list = $(\"question-card\").querySelector(\".builder-field-errors\");\n      if (!list) return;\n      const index = state.questions.findIndex((q) => q.id === selected);\n      const errors = Object.entries(readiness()).filter(([key]) => key.startsWith(`questions.$