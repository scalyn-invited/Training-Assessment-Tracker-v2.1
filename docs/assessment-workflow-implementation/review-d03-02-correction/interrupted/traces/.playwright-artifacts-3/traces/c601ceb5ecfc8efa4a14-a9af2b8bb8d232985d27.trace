pace-header,.growth-orbit{display:none}.workspace-hero{background:#fff;color:#111}.workspace-hero p,.workspace-hero .eyebrow{color:#333}}\n\n/* Keep the supplied full-colour logo legible in every theme. */\n.brand-symbol:has(.brand-logo){max-width:60px;min-width:54px;padding:5px;border:0!important;border-radius:7px;background:#fff}.brand-symbol .brand-logo{width:50px;height:36px}.guest-header .brand-logo{width:60px;height:44px;padding:4px;background:#fff;border-radius:7px}.preview-logo{background:#fff;padding:3px;border-radius:5px}\n\n/* M1 scoped client header and accessible navigation integration. Theme tokens remain authoritative. */\n.workspace-header{height:auto;min-height:88px;flex-wrap:wrap;padding-top:16px;padding-bottom:16px}\n.client-switcher{flex:1 1 260px;max-width:480px;min-width:0;margin:0}\n.client-switcher label{font-size:12px;color:var(--muted)}\n.client-controls{display:flex;align-items:center;gap:8px}\n.client-controls select{flex:1;min-width:0;margin:0}\n.client-controls button{white-space:nowrap;min-height:44px}\n.workspace-header .profile{margin-left:auto;min-width:0}\n.app-sidebar{overflow-y:auto}.nav-open{overflow:hidden}\n.table-wrap:focus-visible{outline:2px solid var(--focus);outline-offset:3px}\n.skip{display:inline-flex;align-items:center;min-height:44px}\n.container>.panel,.container>section,.container>form{margin-bottom:24px}\n.panel{min-width:0;overflow-wrap:anywhere}.badge{white-space:normal}\n@media(max-width:800px){\n .workspace-header{gap:14px}.workspace-header .profile{width:auto;flex:1 1 100%}\n .client-switcher{flex-basis:100%;max-width:none}.client-controls button{font-size:12px;padding:8px}\n .app-layout:not(.navigation-ready) .app-sidebar{position:static;width:100%;visibility:visible;transform:none;height:auto}\n .app-layout:not(.navigation-ready) .mobile-bar{display:none}\n}\n\n/* Branding accents are decorative; theme contrast tokens continue to control text and controls. */\n.brand-logo,.preview-logo{background:#f5f5f5;border-radius:5px;padding:3px;object-fit:contain}\n\n/* Client palette is opt-in and never overrides the five built-in themes. */\n:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]){color-scheme:var(--client-scheme,light);--bg:var(--client-background);--surface:var(--client-card);--raised:var(--client-card);--hover:var(--client-background);--ink:var(--client-text);--muted:var(--client-text);--line:var(--client-text);--primary:var(--client-primary);--on-primary:var(--client-on-primary);--focus:var(--client-text);--soft:var(--client-card);--brand:var(--client-primary)}\n:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]) .primary:hover{filter:none;text-decoration:underline}\n:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]) .workspace-hero{background:var(--primary);color:var(--on-primary);border-color:var(--primary)}\n:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]) .workspace-hero .eyebrow,:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]) .workspace-hero p:not(.eyebrow),:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]) .growth-orbit span{color:var(--on-primary)}\n:root:is([data-theme=client],[data-theme=client-light],[data-theme=client-dark]) .growth-orbit{border-color:var(--on-primary);box-shadow:none}\n.sample-client{--sample-bg:var(--client-background);--sample-surface:var(--client-card);--sample-accent:var(--client-primary)}\n.theme-dot-client{background:var(--client-primary)}\n.client-colour-editor{margin-top:24px}.client-colour-editor legend{font-size:16px}.client-colour-editor .form-grid{gap:12px}\n.client-preview-card{display:flex;flex-direction:column;gap:14px;border:1px solid var(--preview-text);border-radius:6px;padding:16px;background:var(--preview-card);color:var(--preview-text)}\n.client-preview-button{align-self:flex-start;border-radius:6px;padding:9px 15px;background:var(-