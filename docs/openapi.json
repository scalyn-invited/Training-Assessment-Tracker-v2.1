    "/clients/select": {
      "post": {
        "summary": "Select an authorized client",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "description": "Requires configured Origin and session CSRF. Effective authority is rechecked in the mutation transaction.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["csrf", "clientId"],
                "properties": {
                  "csrf": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "clientId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Saved."
          },
          "401": {
            "description": "Session expired or access revoked."
          },
          "403": {
            "description": "Missing authority, Origin or CSRF rejected."
          },
          "404": {
            "description": "Scoped object unavailable."
          },
          "409": {
            "description": "Version or authority conflict."
          },
          "422": {
            "description": "Validation failed."
          }
        }
      }
    },
