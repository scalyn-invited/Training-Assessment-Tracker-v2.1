    "/auth/mfa/confirm": {
      "post": {
        "summary": "Confirm enrollment and return ten recovery codes once",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "description": "Requires the configured APP_ORIGIN in Origin and the current session CSRF token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csrf": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$"
                  }
                },
                "required": ["csrf", "code"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Operation succeeded. Secrets and recovery codes are returned only by their enrollment operation."
