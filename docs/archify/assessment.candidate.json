  "cards": [
    {"dot": "rose", "title": "Authority and privacy", "items": ["Assignment requires current primary coordinator and sensitive authority. Review disallows self-review.", "An open appeal blocks editing and resubmission. Alternate access depends on the exact active case and role; it ends on resolution.", "Client Admin routing does not confer assessment-content access. See HANDOFF.md for role boundaries."]},
    {"dot": "amber", "title": "Waiting and recovery", "items": ["Incomplete content or unready images block publication. Never imply scan success from upload completion.", "Save conflicts preserve input. Retry an uncertain submission with the same request identity rather than creating a second attempt.", "Optional analysis remains private and provisional; pending analysis blocks the human decision. Extraction is not evidence confirmation."]},
    {"dot": "cyan", "title": "Separate from onboarding", "items": ["Published revisions and submitted attempts retain history. A rejected attempt may be edited into a new saved draft when no appeal is open.", "This workflow does not automatically populate onboarding findings. Onboarding requires explicit coordinator confirmation.", "Sources describe the pinned implementation. Screen layout and usability acceptance remain for designer review."]}
