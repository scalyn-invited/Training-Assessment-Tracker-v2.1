  "cards": [
    {"dot": "cyan", "title": "Learning is not automatic approval", "items": ["The workflow starts only after explicit activation. Future lessons remain preview-only unless a coordinator explicitly starts the block early.", "Manual review is supported; provider analysis is optional and provisional. Insufficient evidence cannot become an official numeric grade.", "A changes-requested decision does not erase an earlier approved grade. New attempts require an eligible prior status."]},
    {"dot": "rose", "title": "Appeals and support are separate branches", "items": ["Learning appeals concern an approved grade: Member requests, Client Admin routes, alternate reviewer resolves. Do not reuse initial-assessment appeal eligibility.", "Support/adaptation requires approved source evidence. N+2 proposals can affect only eligible future blocks, before freeze and without started/submitted work.", "A human must explicitly approve a fresh adaptation. See HANDOFF.md for evidence and constraints."]},
    {"dot": "amber", "title": "Lifecycle recovery · see lifecycle.html", "items": ["The optional active → pause → preview → resume → active branch is drawn separately in lifecycle.html for readability.", "If the preview is stale or capacity fails, stay paused and create a new preview; preserve the user's reason.", "Completion is not a timer: every required lesson needs approved evidence and every current KPI must be on target, with at least three targets."]}
