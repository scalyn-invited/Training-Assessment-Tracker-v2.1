TRAINING_INSTALL_STATE=pending
# Leave DATABASE_URL absent for local PGlite. Never use production data for tests.
WEB_PORT=3100
API_PORT=3101
PGLITE_PORT=55431
APP_ORIGIN=http://localhost:3100
PRIVATE_STORAGE_PATH=.runtime/private
# DATABASE_URL=postgresql://runtime:password@localhost:5432/training_v21
# MIGRATION_DATABASE_URL=postgresql://migration_owner:password@localhost:5432/training_v21
# TEST_POSTGRES_URL=postgresql://test_owner:password@localhost:5432/training_v21_test
# Local synthetic provisional analysis. Live adapters require separate qualification.
AI_LIVE_ENABLED=false
AI_ORGANISATION_LIMIT_MICRO_USD=10000000
AI_PROGRAMME_LIMIT_MICRO_USD=5000000
AI_ANTHROPIC_ENABLED=false
AI_GEMINI_ENABLED=false
# Enabled provider profiles also require explicit model, data classes, pricing and rate version.
# AI_ANTHROPIC_API_KEY=
# AI_ANTHROPIC_MODEL=
# AI_ANTHROPIC_DATA_CLASSES=confirmed_training
# AI_ANTHROPIC_INPUT_RATE=
# AI_ANTHROPIC_OUTPUT_RATE=
# AI_ANTHROPIC_RATE_VERSION=
# AI_GEMINI_API_KEY=
# AI_GEMINI_MODEL=
# AI_GEMINI_DATA_CLASSES=confirmed_training
# AI_GEMINI_INPUT_RATE=
# AI_GEMINI_OUTPUT_RATE=
# AI_GEMINI_RATE_VERSION=
# Document extraction tools: absolute paths only; never set from a browser request.
# DOCUMENT_PDFINFO=
# DOCUMENT_PDFTOTEXT=
# DOCUMENT_PDFTOPPM=
# DOCUMENT_TESSERACT=
DOCUMENT_OCR_LANGUAGE=eng
# Production extraction requires a qualified wrapper that denies network access.
# DOCUMENT_SANDBOX_WRAPPER=
# TESSDATA_PREFIX=

# Training email is disabled until deployment and sender authorization.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# APP_ORIGIN must be HTTPS for live notification links.

# Optional synchronous account-link email; exact comma-separated approved recipients.
ACCOUNT_MAIL_ENABLED=false
ACCOUNT_MAIL_RECIPIENTS=

# Synthetic delegated contract harness; never enable in production.
TRAINING_AUTH_MODE=local_password
TRAINING_ENVIRONMENT=test
MOCK_IDENTITY_ENABLED=false
MOCK_IDENTITY_ISSUER=https://identity.example.invalid/mock
MOCK_IDENTITY_AUDIENCE=training-sandbox
MOCK_IDENTITY_CLIENT=primary-sandbox

# Evidence retention remains dry-run unless a policy is explicitly approved.
RETENTION_APPROVED=false

# Explicit operator bootstrap profiles (disabled unless deliberately configured).
# NODE_ENV=production
# TRAINING_ENVIRONMENT=production
# TRAINING_AUTH_MODE=local_password
# TRAINING_INSTALL_MODE=hosted
# Hosted APP_ORIGIN must use HTTPS.
# Local production instead requires a designated loopback PostgreSQL database:
# TRAINING_LOCAL_PRODUCTION=true
# TRAINING_LOCAL_PRODUCTION_DATABASE=training_v21_local_production
# APP_ORIGIN=http://127.0.0.1:3100
# API_INTERNAL_ORIGIN=http://127.0.0.1:3101
